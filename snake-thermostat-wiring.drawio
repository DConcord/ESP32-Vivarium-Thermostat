fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="220" width="150" height="90" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Cool DS18B20&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Adapter screw terminal:&lt;br&gt;DAT ← yellow&lt;br&gt;VCC ← red · GND ← black&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="320" width="150" height="90" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Inkbird SSR-40DA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Input side&lt;br&gt;3 (+) ← GPIO19&lt;br&gt;4 (−) ← GND&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#712B13;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="440" width="150" height="90" as="geometry"/></mxCell><mxCell id="c56" value="10k pull-downs on GPIO19 and GPIO18 keep SSR and relay off at boot" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="100" y="413.0" width="150" height="24" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;SH1106 OLED · 0x3C&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Header: GND VCC SCL SDA&lt;br&gt;(left → right)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="180" width="160" height="70" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;SHT30 probe · 0x44&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;2 m cable, wired direct&lt;br&gt;Red VCC · Black GND&lt;br&gt;Yellow/White = SDA/SCL*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="160" height="70" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;RJ45 jack (main board)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Cat6 to IR sensor&lt;br&gt;pairs per table below&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="160" height="70" as="geometry"/></mxCell><mxCell id="c60" value="Cat6 patch, ~1.5 m" style="endArrow=block;html=1;rounded=0;strokeColor=#7F77DD;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="430" as="sourcePoint"/><mxPoint x="640" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="&lt;b&gt;RJ45 screw adapter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;XUGERIP / SchmalzTech&lt;br&gt;+ 100 nF VIN–GND&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="470" width="160" height="90" as="geometry"/></mxCell><mxCell id="c62" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7F77DD;strokeWidth=1;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="560" as="sourcePoint"/><mxPoint x="640" y="588" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="&lt;b&gt;GY-906-DCI (MLX90614)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;0x5A · tall can lens&lt;br&gt;Pins: VIN GND SCL SDA&lt;br&gt;~12 in above stone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="590" width="160" height="90" as="geometry"/></mxCell><mxCell id="c64" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#888780;strokeWidth=1;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="580" as="sourcePoint"/><mxPoint x="380" y="544" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c65" value="&lt;b&gt;USB 5V supply&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Separate outlet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="580" width="160" height="40" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;Cat6 (T568B) pair map → GY-906&lt;/b&gt;&lt;br&gt;Orange (pin 2) = SDA · White/orange (1) = GND&lt;br&gt;Green (pin 6) = SCL · White/green (3) = GND&lt;br&gt;Blue (pin 4) = 3V3 → VIN · White/blue (5) = GND&lt;br&gt;Brown pair (7, 8) = GND or unused&lt;br&gt;&lt;br&gt;&lt;b&gt;DS18B20 Dupont jumpers&lt;/b&gt;: header order DAT / VCC / GND&lt;br&gt;*SHT30 SDA/SCL colors vary by seller: confirm on listing, then I2C scan" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=#B4B2A9;fillColor=#FAFAF8;spacing=8;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="480" height="130" as="geometry"/></mxCell><mxCell id="c67" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E24B4A;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="795" as="sourcePoint"/><mxPoint x="68" y="795" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c68" value="3V3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="74" y="786.0" width="70" height="18" as="geometry"/></mxCell><mxCell id="c69" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#888780;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geo