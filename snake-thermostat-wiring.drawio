lug before touching mains." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="300" y="620" width="380" height="40" as="geometry" /></mxCell><mxCell id="c101" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D85A30;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="700" as="sourcePoint" /><mxPoint x="328" y="700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c102" value="Hot (black)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="334" y="691" width="90" height="18" as="geometry" /></mxCell><mxCell id="c103" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#378ADD;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="700" as="sourcePoint" /><mxPoint x="423" y="700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c104" value="Neutral (white)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="429" y="691" width="90" height="18" as="geometry" /></mxCell><mxCell id="c105" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#639922;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="700" as="sourcePoint" /><mxPoint x="518" y="700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c106" value="Ground (green)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="524" y="691" width="90" height="18" as="geometry" /></mxCell><mxCell id="c107" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7F77DD;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="700" as="sourcePoint" /><mxPoint x="613" y="700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c108" value="Control" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="619" y="691" width="90" height="18" as="geometry" /></mxCell><mxCell id="k15" value="&lt;b&gt;K1 relay shield&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Songle SRD-05VDC-SL-C&lt;br&gt;COM ← L · NO → SSR 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#993556;fontColor=#72243E;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="300" width="160" height="56" as="geometry" /></mxCell><mxCell id="k16" value="K1 NO → SSR 1" style="endArrow=none;html=1;rounded=0;strokeColor=#D85A30;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="356" as="sourcePoint" /><mxPoint x="330" y="388" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k17" value="coil" style="endArrow=none;html=1;rounded=0;strokeColor=#D4537E;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="230" /><mxPoint x="230" y="328" /></Array><mxPoint x="210" y="230" as="sourcePoint" /><mxPoint x="250" y="328" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k18" value="K1 is closed only while the ESP32 permits heat and its heartbeat runs. Keep K1 and SSR mains terminals ≥ 6 mm from low-voltage copper." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="240" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Heater cutoff" id="Heater_cutoff"><mxGraphModel dx="900" dy="800" grid="1" gridSize="10" page="1" pageWidth="900" pageHeight="720"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="k19" value="&lt;b&gt;Heater cutoff: watchdog one-shot + relay&lt;/b&gt; · K1 closed only while PERMIT is high AND HEARTBEAT keeps toggling" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="820" height="24" as="geometry" /></mxCell><mxCell id="k20" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#A32D2D;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="70" as="sourcePoint" /><mxPoint x="860" y="70" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k21" value="5V rail (ESP32 5V/VIN pin)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="200" height="18" as="geometry" /></mxCell><mxCell id="k22" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#888780;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="660" as="sourcePoint" /><mxPoint x="860" y="660" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k23" value="GND (common with ESP32)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="664" width="200" height="18" as="geometry" /></mxCell><mxCell id="k24" value="&lt;b&gt;ESP32&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;GPIO23 HEARTBEAT&lt;br&gt;edge every 500 ms&lt;br&gt;&lt;br&gt;GPIO25 PERMIT&lt;br&gt;low on any fault,&lt;br&gt;Heater Enable off, OTA&lt;br&gt;&lt;br&gt;GPIO34 feedback in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="150" height="200" as="geometry" /></mxCell><mxCell id="k25" value="10k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=10;fontSize=9;" vertex="1" parent="1"><mxGeometry x="215" y="244" width="40" height="16" as="geometry" /></mxCell><mxCell id="k26" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D4537E;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="230" as="sourcePoint" /><mxPoint x="235" y="244" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k27" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#888780;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="260" as="sourcePoint" /><mxPoint x="235" y="268" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k28" value="GND" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="215" y="268" width="40" height="14" as="geometry" /></mxCell><mxCell id="k29" style="ellipse;fillColor=#D4537E;strokeColor=#D4537E;" vertex="1" parent="1"><mxGeometry x="231" y="226" width="8" height="8" as="geometry" /></mxCell><mxCell id="k30" value="10k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=10;fontSize=9;" vertex="1" parent="1"><mxGeometry x="215" y="314" width="40" height="16" as="geometry" /></mxCell><mxCell id="k31" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D4537E;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="300" as="sourcePoint" /><mxPoint x="235" y="314" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k32" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#888780;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="330" as="sourcePoint" /><mxPoint x="235" y="338" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k33" value="GND" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="215" y="338" width="40" height="14" as="geometry" /></mxCell><mxCell id="k34" style="ellipse;fillColor=#D4537E;strokeColor=#D4537E;" vertex="1" parent="1"><mxGeometry x="231" y="296" width="8" height="8" as="geometry" /></mxCell><mxCell id="k35" value="&lt;b&gt;U1 CD74HCT123E&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;retriggerable one-shot, DIP-16&lt;br&gt;&lt;br&gt;pin 2 · 1B ← HEARTBEAT&lt;br&gt;pin 3 · 1/CLR ← PERMIT&lt;br&gt;pin 1 · 1A → GND&lt;br&gt;pin 13 · 1Q → Q1 gate, feedback&lt;br&gt;pin 14/15 · Cext / Rext-Cext&lt;br&gt;pin 16 VCC · pin 8 GND&lt;br&gt;pins 9→5V, 10, 11→GND (unused ch.)&lt;br&gt;&lt;br&gt;100 nF VCC–GND at pin 16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#993556;fontColor=#72243E;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="220" height="280" as="geometry" /></mxCell><mxCell id="k36" value="HEARTBEAT" style="endArrow=none;html=1;rounded=0;strokeColor=#D4537E;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="230" as="sourcePoint" /><mxPoint x="320" y="230" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k37" value="PERMIT" style="endArrow=none;html=1;rounded=0;strokeColor=#D4537E;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="300" as="sourcePoint" /><mxPoint x="320" y="300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k38" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#A32D2D;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="150" as="sourcePoint" /><mxPoint x="430" y="70" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k39" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#888780;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="430" as="sourcePoint" /><mxPoint x="530" y="660" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k40" value="&lt;b&gt;Timing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;1 MΩ 1%: pin 15 → 5V&lt;br&gt;4.7 µF film: pin 14 ↔ pin 15&lt;br&gt;t ≈ 0.45·R·C ≈ 2.1 s (measure)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="470" width="180" height="70" as="geometry" /></mxCell><mxCell id="k41" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#5F5E5A;strokeWidth=1;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="430" as="sourcePoint" /><mxPoint x="380" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k42" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#5F5E5A;strokeWidth=1;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="430" as="sourcePoint" /><mxPoint x="480" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k43" value="&lt;b&gt;Divider&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;1Q → 10k → GPIO34&lt;br&gt;GPIO34 → 20k → GND&lt;br&gt;5 V → 3.3 V&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="120" height="70" as="geometry" /></mxCell><mxCell id="k44" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D4537E;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="300" as="sourcePoint" /><mxPoint x="660" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k45" style="ellipse;fillColor=#D4537E;strokeColor=#D4537E;" vertex="1" parent="1"><mxGeometry x="656" y="296" width="8" height="8" as="geometry" /></mxCell><mxCell id="k46" value="to GPIO34" style="endArrow=none;html=1;rounded=0;strokeColor=#D4537E;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="560" /><mxPoint x="115" y="560" /></Array><mxPoint x="630" y="540" as="sourcePoint" /><mxPoint x="115" y="380" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k47" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#888780;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="540" as="sourcePoint" /><mxPoint x="690" y="660" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k48" value="&lt;b&gt;R4 100k&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;relay IN → GND&lt;br&gt;holds K1 off if U1&lt;br&gt;is unplugged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="270" width="150" height="70" as="geometry" /></mxCell><mxCell id="k49" value="1Q" style="endArrow=none;html=1;rounded=0;strokeColor=#D4537E;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="300" as="sourcePoint" /><mxPoint x="700" y="300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k50" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#888780;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="340" as="sourcePoint" /><mxPoint x="775" y="660" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k51" value="&lt;b&gt;K1 relay shield&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Songle SRD-05VDC-SL-C&lt;br&gt;IN (D1 pin) ← 1Q&lt;br&gt;5V, GND · driver on board&lt;br&gt;100 µF 5V–GND nearby&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#993556;fontColor=#72243E;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="150" height="90" as="geometry" /></mxCell><mxCell id="k52" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#A32D2D;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="130" as="sourcePoint" /><mxPoint x="775" y="70" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k53" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D4537E;strokeWidth=2;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="220" as="sourcePoint" /><mxPoint x="775" y="270" as="targetPoint" /></mxGeometry></mxCell><mxCell id="k54" value="K1 contacts (COM → NO) are in series with the SSR on the hot conductor. See &lt;i&gt;Mains side&lt;/i&gt;. NC unused." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="560" y="590" width="300" height="60" as="geometry" /></mxCell><mxCell id="k55" value="&lt;b&gt;Behaviour&lt;/b&gt;&lt;br&gt;Boot / reset / flashing: open (pull-downs)&lt;br&gt;Fault, Heater Enable off, OTA: open at once&lt;br&gt;Heartbeat stops: open after ~2.1 s&lt;br&gt;5 V lost: open&lt;br&gt;Fault clears: closes on its own" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>